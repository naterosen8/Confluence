# Optional. Without this, the dashboard runs on generated demo data.
# Get a free key at https://twelvedata.com (free tier: 8 requests/min, 800/day)
VITE_TWELVE_DATA_KEY=

# Optional. Without this, prices come only from the Twelve Data cycle above
# (updates every few minutes). With it, US stock/ETF prices update every
# ~30s via a lightweight polling loop — a display-only overlay, doesn't
# affect any indicator or backtest.
# Get a free key at https://finnhub.io (free tier: 60 requests/min)
VITE_FINNHUB_KEY=
